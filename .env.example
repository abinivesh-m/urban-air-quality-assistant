# Copy to .env.local and fill in. None of these are required; the app falls
# back to its deterministic rule engine when no key is present.

# OpenAI (or any OpenAI-compatible gateway, e.g. Antigravity)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000

# Google Gemini (used only when OPENAI_API_KEY is absent)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=8000